# Скопіюйте у gradle.properties (він у .gitignore) і за потреби вкажіть шлях до JDK 8.
# Copy to gradle.properties (git-ignored) and point org.gradle.java.home at a JDK 8 if JAVA_HOME is not one.

# Required: Azure app (client) id for "Sign in with Microsoft". Register your own app; see README.
microsoftClientId=00000000-0000-0000-0000-000000000000

#org.gradle.java.home=C:\\Program Files\\Java\\jdk1.8.0_202
org.gradle.jvmargs=-Xmx1024M -Dgroovy.source.encoding=UTF-8 -Dfile.encoding=UTF-8
systemProp.file.encoding=utf-8
org.gradle.parallel=true
org.gradle.daemon=true
org.gradle.warning.mode=none
